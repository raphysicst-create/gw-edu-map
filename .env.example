# 강원 전용 profile. 두 값은 데이터 빌드와 화면에서 같아야 합니다.
EDU_MAP_PROFILE=gangwon
NEXT_PUBLIC_EDU_MAP_PROFILE=gangwon

# 실제 공개 주소가 확정되기 전에는 비워 둡니다.
NEXT_PUBLIC_SITE_URL=

# VWorld 서비스별 키·등록 도메인. 비밀 서버 키는 공개 변수로 옮기지 않습니다.
# 현재 profile review에서 배경지도·건물 호출을 막으므로 키만 입력해도 켜지지 않습니다.
NEXT_PUBLIC_VWORLD_KEY=
VWORLD_BUILDING_KEY=
VWORLD_BUILDING_DOMAIN=
NEXT_PUBLIC_BUILDINGS_ENABLED=false
BUILDINGS_ENABLED=false
